{
  "name": "@sieve/nextjs",
  "version": "0.1.0-dev",
  "description": "Next.js + Vercel AI SDK helpers for sieve (vendor-neutral prompt injection defense)",
  "license": "(MIT OR Apache-2.0)",
  "repository": { "type": "git", "url": "git+https://github.com/Trit1967/sieve.git" },
  "homepage": "https://github.com/Trit1967/sieve",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./openai": {
      "import": "./dist/openai.mjs",
      "require": "./dist/openai.js",
      "types": "./dist/openai.d.ts"
    },
    "./ai-sdk": {
      "import": "./dist/ai-sdk.mjs",
      "require": "./dist/ai-sdk.js",
      "types": "./dist/ai-sdk.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["prompt-injection", "llm", "security", "ai-safety", "nextjs", "edge-runtime", "vercel"],
  "scripts": {
    "build": "echo 'Phase 13 implements the real build (tsup)'",
    "test": "echo 'Phase 13 implements the real test suite (vitest)'"
  },
  "peerDependencies": {
    "@sieve/wasm": "workspace:*"
  },
  "engines": { "node": ">=20" }
}
