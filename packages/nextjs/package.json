{
  "name": "@sieve/nextjs",
  "version": "0.3.0",
  "description": "Next.js + Vercel AI SDK helpers for sieve (vendor-neutral prompt injection defense)",
  "license": "(MIT OR Apache-2.0)",
  "repository": { "type": "git", "url": "git+https://github.com/Trit1967/sieve.git" },
  "homepage": "https://github.com/Trit1967/sieve",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js",
      "require": "./dist/openai.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "require": "./dist/ai-sdk.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["prompt-injection", "llm", "security", "ai-safety", "nextjs", "edge-runtime", "vercel"],
  "scripts": {
    "build": "tsup src/index.ts src/openai.ts src/ai-sdk.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sieve/wasm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@sieve/wasm": { "optional": false }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": { "node": ">=20" }
}
